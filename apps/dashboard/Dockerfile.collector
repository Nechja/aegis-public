FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /collector ./cmd/collector

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /collector /collector
ENTRYPOINT ["/collector"]
