    private async Task UninstallOne(InstalledApp app)
    {
        if (_vm is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove package?",
            $"Uninstall {app.Name} ({app.Source}) from {_vm.Name}?",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true) return;

        var script = app.Source switch
        {
            PackageLinuxSource.Snap => $"snap remove {app.Name}",
            _ => $"export DEBIAN_FRONTEND=noninteractive && apt-get remove -y {app.Name}"
        };
        var item = new InstallCommandItem($"{app.Source}:{app.Name}", app.Name, script);
        var dict = new Dictionary<Guid, IReadOnlyList<InstallCommandItem>>
        {
            [_vm.Id] = new[] { item }
        };
        try
        {
            await FleetOps.StartUninstall([_vm.Id], dict);
            Snackbar.Add($"Uninstall queued for {app.Name}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Uninstall failed: {ex.Message}", Severity.Error);
        }
    }

    private string FactsCaption()
    {
        if (_vm?.Telemetry is { } t) return $"captured {Humanize(t.CapturedAt)}";
        if (_vm?.AgentVersion is { } v) return $"agent {v} ready, no facts yet";
        return "no facts yet";
    }

    private static Color PercentColor(double p) =>
        p >= 90 ? Color.Error : p >= 70 ? Color.Warning : Color.Success;

    private static string FormatKB(long kb)
    {
        if (kb <= 0) return "—";
        if (kb < 1024) return $"{kb} KB";
        double mb = kb / 1024.0;
        if (mb < 1024) return $"{mb:F1} MB";
        double gb = mb / 1024.0;
        if (gb < 1024) return $"{gb:F1} GB";
        return $"{gb / 1024.0:F2} TB";
    }

    private static string HumanizeUptime(long seconds)
    {
        if (seconds <= 0) return "—";
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalDays >= 1) return $"{(int)ts.TotalDays}d {ts.Hours}h";
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m";
        return $"{ts.Seconds}s";
    }

    private async Task Stop()
    {
        if (_vm is null) return;
        _busy = true;
        if (await KubeVirt.Stop(_vm))
        {
            _vm.State = VmState.Stopped;
            Db.Vms.Update(_vm);
            Db.Audit.Insert(new AuditEntry { Action = "vm.stop", ResourceId = _vm.Id.ToString(), Detail = $"Stopped {_vm.Name}" });
            Snackbar.Add("Stopped", Severity.Info);
            Load();
        }
        else Snackbar.Add("Failed to stop", Severity.Error);
        _busy = false;
    }

    private async Task Start()
    {
        if (_vm is null) return;
        _busy = true;
        if (await KubeVirt.Start(_vm))
        {
            _vm.State = VmState.Starting;
            Db.Vms.Update(_vm);
            Db.Audit.Insert(new AuditEntry { Action = "vm.start", ResourceId = _vm.Id.ToString(), Detail = $"Starting {_vm.Name}" });
            Snackbar.Add("Starting...", Severity.Success);
            Load();
        }
        else Snackbar.Add("Failed to start", Severity.Error);
        _busy = false;
    }

    private async Task Dismiss()
    {
        if (_vm is null) return;
        _busy = true;
        _vm.State = VmState.Deleting;
        Db.Vms.Update(_vm);
        StateHasChanged();
        if (await KubeVirt.Delete(_vm))
        {
            Db.Vms.Delete(_vm.Id);
            Db.Audit.Insert(new AuditEntry { Action = "vm.dismiss", ResourceId = _vm.Id.ToString(), Detail = $"Dismissed {_vm.Name}" });
            Snackbar.Add($"Dismissed {_vm.Name}", Severity.Warning);
            Nav.NavigateTo("/");
        }
        else
        {
            Snackbar.Add("Failed to dismiss — some resources may remain", Severity.Error);
            _busy = false;
        }
    }

    private static Color PhaseColor(string phase) => phase switch
    {
        PackageInstallPhase.Installed => Color.Success,
        PackageInstallPhase.Failed => Color.Error,
        PackageInstallPhase.Installing => Color.Info,
        _ => Color.Default
    };

    private static string PhaseIcon(string phase) => phase switch
    {
        PackageInstallPhase.Installed => Icons.Material.Outlined.CheckCircle,
        PackageInstallPhase.Failed => Icons.Material.Outlined.ErrorOutline,
        PackageInstallPhase.Installing => Icons.Material.Outlined.Sync,
        _ => Icons.Material.Outlined.HourglassEmpty
    };

    private static string ActionIcon(string action) => action switch
    {
        "vm.summon" => Icons.Material.Outlined.AutoAwesome,
        "vm.start" => Icons.Material.Outlined.PlayArrow,
        "vm.stop" => Icons.Material.Outlined.Stop,
        "vm.dismiss" => Icons.Material.Outlined.DeleteForever,
        var a when a.StartsWith("agent.install.done", StringComparison.Ordinal) => Icons.Material.Outlined.Inventory2,
        var a when a.StartsWith("agent.install.progress", StringComparison.Ordinal) => Icons.Material.Outlined.Sync,
        var a when a.StartsWith("agent.inventory", StringComparison.Ordinal) => Icons.Material.Outlined.ViewList,
        var a when a.StartsWith("agent.exec", StringComparison.Ordinal) => Icons.Material.Outlined.Terminal,
        var a when a.StartsWith("agent.", StringComparison.Ordinal) => Icons.Material.Outlined.Sensors,
        _ => Icons.Material.Outlined.Circle
    };

    private static Color ActionColor(string action) => action switch
    {
        "vm.summon" => Color.Primary,
        "vm.start" => Color.Success,
        "vm.stop" => Color.Warning,
        "vm.dismiss" => Color.Error,
        var a when a.Contains("install.done") => Color.Success,
        var a when a.Contains("install.progress") => Color.Info,
        _ => Color.Default
    };

    private string SoftwareSummary()
    {
        if (_vm is null) return "";
        if (_vm.SoftwareInstalls is { Count: > 0 } list)
        {
            var ok = list.Count(x => x.Phase == PackageInstallPhase.Installed);
            var failed = list.Count(x => x.Phase == PackageInstallPhase.Failed);
            var pending = list.Count(x => x.Phase is PackageInstallPhase.Pending or PackageInstallPhase.Installing);
            return $"{ok}/{list.Count} installed · {pending} in progress" + (failed > 0 ? $" · {failed} failed" : "");
        }
        return _vm.Packages.Count == 0 ? "none" : string.Join(" · ", _vm.Packages);
    }

    private static string OsFamilyLabel(string family) =>
        string.Equals(family, TemplateOsFamilies.Windows, StringComparison.OrdinalIgnoreCase) ? "Windows" : "Linux";

    private static string Humanize(DateTime ts)
    {
        var delta = DateTime.UtcNow - ts;
        if (delta.TotalSeconds < 60) return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours < 24) return $"{(int)delta.TotalHours}h ago";
        return $"{(int)delta.TotalDays}d ago";
    }

    public void Dispose() => _subscription?.Dispose();
