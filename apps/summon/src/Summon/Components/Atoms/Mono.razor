@namespace Summon.Components.Atoms

<span class="@Classes">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Size { get; set; }

    private string Classes => string.IsNullOrWhiteSpace(Class)
        ? $"aegis-mono {Size}"
        : $"aegis-mono {Size} {Class}";
}
