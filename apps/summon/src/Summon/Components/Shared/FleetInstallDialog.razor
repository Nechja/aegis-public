@namespace Summon.Components.Shared
@inject Summon.Services.FleetOperationService FleetOps
@inject Summon.Services.Data.SummonDb Db
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Install on @TargetCount VM@(TargetCount == 1 ? "" : "s")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Pick packages to push to the selected VMs. Same stack, different boxes — build it once, ship it everywhere.
        </MudText>
        <Forge OsFamily="@TemplateOsFamilies.Linux"
               CuratedPackages="@_curated"
               SelectedPackages="@_selectedPackages"
               DynamicPackages="@_dynamicPackages"
               OnChanged="StateHasChanged"
               Subtitle="search, recipe, or browse — your payload builds below." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="Install" Disabled="@(_submitting || _selectedPackages.Count == 0)">
            @(_submitting ? "Starting…" : "Install")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Guid> TargetVmIds { get; set; } = [];
    [Parameter] public int TargetCount { get; set; }

    private List<SoftwarePackage> _curated = [];
    private readonly HashSet<string> _selectedPackages = [];
    private readonly List<SoftwarePackage> _dynamicPackages = [];
    private bool _submitting;

    protected override void OnInitialized()
    {
        _curated = Db.Packages.FindAll().ToList();
    }

    private IEnumerable<SoftwarePackage> AllPackages => _curated.Concat(_dynamicPackages);

    private async Task Install()
    {
        if (_selectedPackages.Count == 0) return;
        _submitting = true;
        try
        {
            var items = AllPackages
                .Where(p => _selectedPackages.Contains(p.Name))
                .Select(p => (Pkg: p, Snippet: p.LinuxSnippet?.Trim() ?? ""))
                .Where(x => !string.IsNullOrWhiteSpace(x.Snippet))
                .Select(x => new InstallCommandItem(x.Pkg.Name, x.Pkg.DisplayName, x.Snippet))
                .ToList();

            if (items.Count == 0)
            {
                Snackbar.Add("No runnable snippets in the selection.", Severity.Warning);
                _submitting = false;
                return;
            }

            await FleetOps.StartInstall(TargetVmIds, items);
            Snackbar.Add($"Install started on {TargetVmIds.Count} VM{(TargetVmIds.Count == 1 ? "" : "s")}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Install failed to start: {ex.Message}", Severity.Error);
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
